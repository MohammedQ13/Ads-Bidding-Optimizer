# The engine's stats API, fetched SERVER-SIDE by /api/stats (not the browser).
# This is why the HTTPS Vercel frontend can talk to an HTTP GCP backend with no
# mixed-content/CORS issues. NOT prefixed NEXT_PUBLIC — it stays server-side.
#
# Local dev (docker compose / a local engine):
BACKEND_URL=http://localhost:9200
# Production: set this in Vercel to your GCP backend, e.g. http://<vm-ip>:9200
